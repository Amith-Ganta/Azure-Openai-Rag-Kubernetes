terraform {
  required_version = ">= 1.5.0"

  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 4.0"
    }
  }
}

provider "azurerm" {
  features {}

  # Azure for Students subscription. Overridable via TF_VAR / -var.
  subscription_id = var.subscription_id
}
